# Public site URL (SEO, Open Graph, email links, signup redirect). No trailing slash.
# Production: https://stock-pulse.in — set in Vercel/hosting and locally if you test prod URLs.
# NEXT_PUBLIC_APP_URL=https://stock-pulse.in
#
# Supabase → Authentication → URL Configuration → add Redirect URLs (www and non-www if you use both):
#   https://stock-pulse.in/auth/callback
#   https://www.stock-pulse.in/auth/callback
# (and http://localhost:3000/auth/callback for local dev)
#
# Signup / “confirm email” messages use Supabase Auth’s mailer. The default has a
# low hourly cap — if you see “email rate limit exceeded”, wait or set up
# Authentication → Emails → SMTP (e.g. smtp.resend.com + RESEND_API_KEY) so
# limits follow your provider instead.

# Supabase — server only (never expose to the browser)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # required for POST /api/profile/ensure, portfolio APIs, crons, etc.

# Postgres connection (Supabase → Settings → Database → URI). Used by npm run db:setup / db:migrate.
# For migrations, prefer Session pooler or direct :5432 if transaction pooler errors on DDL.
# Set in Vercel too so `prebuild` runs supabase/migrations before `next build`.
# Emergency skip: SKIP_DB_MIGRATE=1 npm run build
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Google Search Console — only the meta `content` value (Next.js renders the <meta> tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Comma-separated profile URLs for JSON-LD sameAs (X, LinkedIn, etc.)
# NEXT_PUBLIC_SOCIAL_PROFILES=

# Optional Twitter/X cards — e.g. @stockpulse or https://twitter.com/stockpulse
# NEXT_PUBLIC_TWITTER_SITE=
# NEXT_PUBLIC_TWITTER_CREATOR=

# Resend — https://resend.com/api-keys (do not commit real keys)
RESEND_API_KEY=

# Optional; defaults to onboarding@resend.dev for testing. Use your verified domain in production.
# EMAIL_FROM=StockPulse <hello@yourdomain.com>

# --- AI (at least one provider) ---
# Stock AI & Copilot prefer (in order): Ollama → Groq → Gemini → OpenAI → Anthropic.
# Vercel/serverless: use GROQ_API_KEY (free); Ollama only if reachable from the server (public URL + OLLAMA_BASE_URL).
#
# Cloud: https://console.groq.com — free tier, open-weight models (Llama, etc.)
# GROQ_API_KEY=
# Optional override (default llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Local open-weight models: https://ollama.com — install Ollama, then e.g. `ollama pull llama3.2`
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Remote Ollama (LAN/VPS): set OLLAMA_BASE_URL=https://your-host:11434 — no need for OLLAMA_ENABLED if not localhost
# OLLAMA_MODEL=llama3.2

# Other providers (optional)
# GOOGLE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Premium / broker access request → admin inbox (defaults to memonjabbar2@gmail.com if unset)
# ADMIN_NOTIFY_EMAIL=

# Dev-only POST /api/dev/test-email (Bearer) — pick a random string; never use in production URLs
# EMAIL_TEST_SECRET=
# Default "to" for that route if body omits `to`
# EMAIL_TEST_TO=
